# Register every AgentBox template that new sessions may select.
# Optional trusted-side masker; also set mask_input = true inside a selected
# [profiles.<name>] section. Existing sessions keep their creation-time policy.
# [input_masker]
# url = "http://127.0.0.1:3101"
# timeout_seconds = 30
# Optional access credential: choose one source, never an inline token.
# token_env = "MASKER_ACCESS_TOKEN"
# token_file = "/run/secrets/masker_access_token"

[templates.orpheus-codex]
description = "Codex sandbox"

[profiles.default]
description = "Default Codex profile"
harness = "codex"
# Set the model here or provide agent.model when creating a session.

# Optional Codex options for this profile (omitted values use Codex defaults):
# [profiles.default.codex]
# effort = "medium"
# summary = "auto"
# personality = "friendly"
# service_tier = "default"

[profiles.default.auth]
mode = "api_key"
api_key_env = "OPENAI_API_KEY"

# Account profile example:
# [credential_stores.main]
# type = "s3"
# bucket = "orpheus-credentials"
# region = "us-east-1"
# [profiles.account]
# harness = "codex"
# model = "your-model"
# [profiles.account.auth]
# mode = "account"
# account_id = "team-main"
# store = "main"
# key = "codex/team/auth.json"
